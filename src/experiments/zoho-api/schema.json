[
  {
    "namespace": "zohoApi",
    "description": "Privileged Zoho Mail API client (alpha: in-memory access token, nothing persisted) plus native junk-marking. Unofficial; not affiliated with Zoho.",
    "functions": [
      {
        "name": "setConnection",
        "type": "function",
        "async": true,
        "description": "Hold an access token in memory for a data center ('com', 'eu', 'in', 'com.au', 'com.cn'). In-memory only in the alpha.",
        "parameters": [
          {
            "name": "options",
            "type": "object",
            "properties": {
              "dc": {
                "type": "string",
                "optional": true
              },
              "accessToken": {
                "type": "string"
              },
              "expiresInSeconds": {
                "type": "integer",
                "optional": true
              }
            },
            "required": [
              "accessToken"
            ]
          }
        ],
        "returnType": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "name": "clearConnection",
        "type": "function",
        "async": true,
        "parameters": [],
        "returnType": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "name": "connectionStatus",
        "type": "function",
        "async": true,
        "parameters": [],
        "description": "Returns { connected, dc, expiresAt } without exposing the token.",
        "returnType": {
          "type": "object",
          "properties": {
            "connected": {
              "type": "boolean"
            },
            "dc": {
              "type": "string",
              "optional": true
            },
            "expiresAt": {
              "type": "number"
            }
          }
        }
      },
      {
        "name": "listAccounts",
        "type": "function",
        "async": true,
        "parameters": [],
        "description": "GET /api/accounts -> [{email, accountId}].",
        "returnType": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      {
        "name": "report",
        "type": "function",
        "async": true,
        "description": "Find the Zoho messageId matching the given message details, then PUT updatemessage mode=moveToSpam. Returns { ok, messageId?, error? }.",
        "parameters": [
          {
            "name": "details",
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string"
              },
              "fromAddress": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "dateEpochMs": {
                "type": "number"
              },
              "internetMessageId": {
                "type": "string",
                "optional": true
              },
              "mode": {
                "type": "string",
                "optional": true,
                "description": "'moveToSpam' (default) or 'markNotSpam'."
              },
              "inJunk": {
                "type": "boolean",
                "optional": true,
                "description": "True when the message currently sits in a junk folder; widens the messageId lookup to Zoho's Spam folder."
              }
            },
            "required": [
              "accountId",
              "fromAddress",
              "subject",
              "dateEpochMs"
            ]
          }
        ],
        "returnType": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "name": "markJunkSelected",
        "type": "function",
        "async": true,
        "description": "Mark the currently selected message junk in the most recent 3-pane window, inheriting the user's junk settings. Returns { ok, method?, error? }.",
        "parameters": [
          {
            "name": "options",
            "type": "object",
            "optional": true,
            "properties": {
              "notJunk": {
                "type": "boolean",
                "optional": true,
                "description": "Mark not junk instead of junk."
              }
            }
          }
        ],
        "returnType": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "name": "dumpAccounts",
        "type": "function",
        "async": true,
        "description": "Debug: GET /api/accounts with the raw JSON body returned as a string.",
        "parameters": [],
        "returnType": {
          "type": "object",
          "additionalProperties": true
        }
      }
    ]
  }
]
