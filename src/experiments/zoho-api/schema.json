[
  {
    "namespace": "zohoApi",
    "description": "Privileged Zoho Mail API client: OAuth connect flow (loopback callback, refresh token in Thunderbird's password manager, access token in memory), plus native junk-marking. Unofficial; not affiliated with Zoho.",
    "functions": [
      {
        "name": "setConnection",
        "type": "function",
        "async": true,
        "description": "Hold an access token in memory for a data center ('com', 'eu', 'in', 'com.au', 'com.cn'). In-memory only in the alpha.",
        "parameters": [
          {
            "name": "options",
            "type": "object",
            "properties": {
              "dc": {
                "type": "string",
                "optional": true
              },
              "accessToken": {
                "type": "string"
              },
              "expiresInSeconds": {
                "type": "integer",
                "optional": true
              }
            },
            "required": [
              "accessToken"
            ]
          }
        ],
        "returnType": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "name": "clearConnection",
        "type": "function",
        "async": true,
        "parameters": [],
        "returnType": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "name": "setClientConfig",
        "type": "function",
        "async": true,
        "description": "Provide the OAuth client id/secret (read by the extension pages from zoho-client.json).",
        "parameters": [
          {
            "name": "options",
            "type": "object",
            "properties": {
              "clientId": {
                "type": "string"
              },
              "clientSecret": {
                "type": "string"
              }
            },
            "required": [
              "clientId",
              "clientSecret"
            ]
          }
        ],
        "returnType": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "name": "connect",
        "type": "function",
        "async": true,
        "description": "Start the one-click OAuth flow: open the Zoho consent page in the system browser and listen on a loopback port for the redirect. Poll connectState for progress.",
        "parameters": [
          {
            "name": "options",
            "type": "object",
            "optional": true,
            "properties": {
              "dc": {
                "type": "string",
                "optional": true
              }
            }
          }
        ],
        "returnType": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "name": "connectState",
        "type": "function",
        "async": true,
        "description": "Poll the in-flight connect: { status: 'idle' | 'waiting' | 'done' | 'error', message? }.",
        "parameters": [],
        "returnType": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "name": "connectCancel",
        "type": "function",
        "async": true,
        "parameters": [],
        "returnType": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "name": "listConnections",
        "type": "function",
        "async": true,
        "description": "All connected Zoho users: [{ id, dc, username, stored, accounts: [{email, accountId}], error? }].",
        "parameters": [],
        "returnType": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      {
        "name": "disconnect",
        "type": "function",
        "async": true,
        "description": "Remove a stored connection: delete its refresh token from the password manager and drop it from memory.",
        "parameters": [
          {
            "name": "options",
            "type": "object",
            "properties": {
              "dc": {
                "type": "string",
                "optional": true
              },
              "username": {
                "type": "string",
                "optional": true
              }
            }
          }
        ],
        "returnType": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "name": "connectionStatus",
        "type": "function",
        "async": true,
        "parameters": [],
        "description": "True when at least one connection is live or renewable. Does not expose tokens.",
        "returnType": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "name": "listAccounts",
        "type": "function",
        "async": true,
        "parameters": [],
        "description": "GET /api/accounts -> [{email, accountId}].",
        "returnType": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      {
        "name": "report",
        "type": "function",
        "async": true,
        "description": "Find the Zoho messageId matching the given message details, then PUT updatemessage mode=moveToSpam. Returns { ok, messageId?, error? }.",
        "parameters": [
          {
            "name": "details",
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string"
              },
              "fromAddress": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "dateEpochMs": {
                "type": "number"
              },
              "internetMessageId": {
                "type": "string",
                "optional": true
              },
              "mode": {
                "type": "string",
                "optional": true,
                "description": "'moveToSpam' (default) or 'markNotSpam'."
              },
              "inJunk": {
                "type": "boolean",
                "optional": true,
                "description": "True when the message currently sits in a junk folder; widens the messageId lookup to Zoho's Spam folder."
              }
            },
            "required": [
              "accountId",
              "fromAddress",
              "subject",
              "dateEpochMs"
            ]
          }
        ],
        "returnType": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "name": "markJunkSelected",
        "type": "function",
        "async": true,
        "description": "Mark the currently selected message junk in the most recent 3-pane window, inheriting the user's junk settings. Returns { ok, method?, error? }.",
        "parameters": [
          {
            "name": "options",
            "type": "object",
            "optional": true,
            "properties": {
              "notJunk": {
                "type": "boolean",
                "optional": true,
                "description": "Mark not junk instead of junk."
              }
            }
          }
        ],
        "returnType": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "name": "dumpAccounts",
        "type": "function",
        "async": true,
        "description": "Debug: GET /api/accounts with the raw JSON body returned as a string.",
        "parameters": [],
        "returnType": {
          "type": "object",
          "additionalProperties": true
        }
      }
    ]
  }
]
