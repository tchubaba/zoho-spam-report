{
  "manifest_version": 2,
  "name": "Zoho Spam Report",
  "version": "0.1.0",
  "description": "Report junk to Zoho Mail's spam filter from Thunderbird. Unofficial; not affiliated with Zoho.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zoho-spam-report@tchubaba.net",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "storage"
  ],
  "background": {
    "scripts": ["src/background.js"]
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "message_display_action": {
    "default_title": "Report to Zoho as spam"
  },
  "experiment_apis": {
    "zohoApi": {
      "schema": "src/experiments/zoho-api/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["zohoApi"]],
        "script": "src/experiments/zoho-api/experimental-api.js"
      }
    }
  }
}
